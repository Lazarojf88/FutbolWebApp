36517>>>>>>>    //  Returns:
36517>>>>>>>    //      String with "HH:MM:SS" format
36517>>>>>>>    //
36517>>>>>>>    Function TimeToString DateTime dtTime Returns String
36519>>>>>>>        String sHours sMinutes sSeconds
36519>>>>>>>        
36519>>>>>>>        //  Extract parts
36519>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
36520>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
36521>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
36522>>>>>>>        
36522>>>>>>>        //  Fill out with 0
36522>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
36525>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
36528>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
36531>>>>>>>        
36531>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
36532>>>>>>>    End_Function
