36831>>>>>Class cWebSessionManagerStandard is a cWebSessionManager
36832>>>>>    
36832>>>>>    Procedure Construct_Object
36834>>>>>        Handle hoObj
36834>>>>>        
36834>>>>>        Forward Send Construct_Object
36836>>>>>        
36836>>>>>        Set pbSessionCookieHttpOnly to True
36837>>>>>        
36837>>>>>        Property Handle phoUserDD 0      // Handle to the WebAppUser DDO
36838>>>>>        Property Handle phoSessionDD 0   // Handle to the WebAppSession DDO  
36839>>>>>        Property Handle phoCrypto 0      // Handle to the PasswordHasher
36840>>>>>        
36840>>>>>        Get CreateNamed (RefClass(cWebAppUserDataDictionary)) 'oUserDD' to hoObj
36841>>>>>        Set phoUserDD to hoObj
36842>>>>>        
36842>>>>>        Get CreateNamed (RefClass(cWebAppSessionDataDictionary)) 'oSessionDD' to hoObj
36843>>>>>        Set DDO_Server of hoObj to (phoUserDD(Self))
36844>>>>>        Set phoSessionDD to hoObj
36845>>>>>        
36845>>>>>        Property Handle phoCrypto 0   // Handle to the Cryptographer
36846>>>>>        Get CreateNamed (RefClass(cPasswordHasher)) 'oCrypto' to hoObj
36847>>>>>        Set phoCrypto to hoObj
36848>>>>>        
36848>>>>>        Property Boolean pbPasswordHashing True
36849>>>>>        
36849>>>>>        Property Boolean pbCreatingNewSession False
36850>>>>>        Property String psLoginName
36851>>>>>        Property String psUserName ""
36852>>>>>        Property Integer piUserRights 0
36853>>>>>    End_Procedure
36854>>>>>    
36854>>>>>    Procedure End_Construct_Object
36856>>>>>        Forward Send End_Construct_Object
36858>>>>>        
36858>>>>>        Handle hoCrypto
36858>>>>>        Integer iFieldLen
36858>>>>>        If (pbPasswordHashing(Self)) Begin
36860>>>>>            Get phoCrypto to hoCrypto
36861>>>>>            Get_Attribute DF_FIELD_LENGTH of (RefTable(WebAppUser)) (RefTable(WebAppUser.Password)) to iFieldLen
36864>>>>>            If (iFieldLen < (RequiredBufferSize(hoCrypto) + 3)) Begin
36866>>>>>                Error DFERR_PROGRAM "The password field of WebAppUser is not large enough (128)"
36867>>>>>>
36867>>>>>            End
36867>>>>>>
36867>>>>>        End
36867>>>>>>
36867>>>>>    End_Procedure
36868>>>>>    
36868>>>>>    Function CreateSession String sRemoteAddress Returns String
36870>>>>>        String sSessionKey
36870>>>>>        Integer iErr
36870>>>>>        Boolean bLogWebSession
36870>>>>>        Handle hoSessionDD       
36870>>>>>        Get phoSessionDD to hoSessionDD
36871>>>>>        
36871>>>>>        //  Get session key
36871>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
36873>>>>>        
36873>>>>>        Get pbLogWebSession to bLogWebSession
36874>>>>>        If not bLogWebSession Begin
36876>>>>>            Function_Return sSessionKey        
36877>>>>>        End
36877>>>>>>
36877>>>>>
36877>>>>>        //  Store session
36877>>>>>        Send Clear of hoSessionDD
36878>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
36879>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
36880>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
36881>>>>>        Get Request_Validate of hoSessionDD to iErr
36882>>>>>        If (iErr) Begin
36884>>>>>            // this should not happen. If it does its a programming error
36884>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36885>>>>>>
36885>>>>>            Function_Return ""
36886>>>>>        End
36886>>>>>>
36886>>>>>        Send Request_Save of hoSessionDD
36887>>>>>        If (Err) Begin
36889>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
36889>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
36890>>>>>>
36890>>>>>            Function_Return ""
36891>>>>>        End
36891>>>>>>
36891>>>>>       
36891>>>>>        Function_Return sSessionKey        
36892>>>>>    End_Function
36893>>>>>    
36893>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
36895>>>>>        DateTime dtLastAccess dtCurrent
36895>>>>>        TimeSpan tsDiff
36895>>>>>        Integer iErr iSessionTimeout iSpanMinutes
36895>>>>>        Boolean bResult bCreatingNewSession
36895>>>>>        Boolean bLogWebSession bLoadWebApp
36895>>>>>        Integer eLoginMode
36895>>>>>        String sTime
36895>>>>>        Handle hoSessionDD hoUserDD       
36895>>>>>        
36895>>>>>        Move False to bLoadWebApp
36896>>>>>        If (num_arguments >= 2) Begin
36898>>>>>            Move bOptLoadWebApp to bLoadWebApp
36899>>>>>        End
36899>>>>>>
36899>>>>>        
36899>>>>>        Get phoSessionDD to hoSessionDD
36900>>>>>        Get phoUserDD to hoUserDD
36901>>>>>        
36901>>>>>        Get pbLogWebSession to bLogWebSession
36902>>>>>        Get peLoginMode to eLoginMode
36903>>>>>        
36903>>>>>        // for this object, you can only disable logging if login completely is disabled
36903>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
36905>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
36906>>>>>>
36906>>>>>            Function_Return False
36907>>>>>        End
36907>>>>>>
36907>>>>>
36907>>>>>        //  Clear session properties
36907>>>>>        Set psSessionKey to ""
36908>>>>>        Send UpdateSessionProperties True
36909>>>>>        
36909>>>>>        If not bLogWebSession Begin
36911>>>>>            Forward Get ValidateSession sSessionKey to bResult
36913>>>>>            Function_Return bResult
36914>>>>>        End        
36914>>>>>>
36914>>>>>        
36914>>>>>        Move False to bResult
36915>>>>>        Get piSessionTimeout to iSessionTimeout 
36916>>>>>        
36916>>>>>        //  Check if session exists
36916>>>>>        Send Clear of hoSessionDD
36917>>>>>        Move sSessionKey to WebAppSession.SessionKey
36918>>>>>        Send Find of hoSessionDD EQ Index.1
36919>>>>>            
36919>>>>>        If (Found) Begin
36921>>>>>            //  Calculate timespan between now and last access time
36921>>>>>            Move (CurrentDateTime()) to dtCurrent
36922>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
36923>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
36924>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
36925>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
36926>>>>>            
36926>>>>>            //  Check if session didn't time out
36926>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
36928>>>>>                Forward Get ValidateSession sSessionKey to bResult
36930>>>>>                   
36930>>>>>                If (bResult) Begin
36932>>>>>                    //  Update session record
36932>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
36933>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
36934>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
36935>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
36936>>>>>                    Get Request_Validate of hoSessionDD to iErr
36937>>>>>                    If (iErr) Begin
36939>>>>>                        // this should not happen. If it does its a programming error
36939>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36940>>>>>>
36940>>>>>                        Function_Return False
36941>>>>>                    End
36941>>>>>>
36941>>>>>                    Send Request_Save of hoSessionDD
36942>>>>>                    
36942>>>>>                    //  Update user properties
36942>>>>>                    Send UpdateSessionProperties False
36943>>>>>                End
36943>>>>>>
36943>>>>>            End
36943>>>>>>
36943>>>>>            Else Begin
36944>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
36944>>>>>                Get pbCreatingNewSession to bCreatingNewSession
36945>>>>>                
36945>>>>>                If (not(bCreatingNewSession)) Begin
36947>>>>>                    If (not(bLoadWebApp)) Begin
36949>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
36950>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
36951>>>>>>
36951>>>>>                        Send NavigateRefresh of ghoWebApp          // refresh the WebApp at the client (triggers a login)
36952>>>>>                    End
36952>>>>>>
36952>>>>>                    Else Begin
36953>>>>>                        Set pbCreatingNewSession to True                    
36954>>>>>                        Get RecreateSession of ghoWebApp to bResult 
36955>>>>>                        Set pbCreatingNewSession to False                        
36956>>>>>                    End
36956>>>>>>
36956>>>>>                End
36956>>>>>>
36956>>>>>            End
36956>>>>>>
36956>>>>>        End
36956>>>>>>
36956>>>>>        Else Begin
36957>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
36958>>>>>>
36958>>>>>        End
36958>>>>>>
36958>>>>>        
36958>>>>>        Function_Return bResult
36959>>>>>    End_Function
36960>>>>>    
36960>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36962>>>>>        If (not(pbPasswordHashing(Self))) Begin
36964>>>>>            Move sPassword to sHash
36965>>>>>            Function_Return True
36966>>>>>        End
36966>>>>>>
36966>>>>>        
36966>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
36968>>>>>            Function_Return False
36969>>>>>        End
36969>>>>>>
36969>>>>>        Move ("V1$" + sHash) to sHash
36970>>>>>        Function_Return True
36971>>>>>    End_Function
36972>>>>>    
36972>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
36974>>>>>        If (not(pbPasswordHashing(Self))) Begin
36976>>>>>            Move False to bShouldUpgrade
36977>>>>>            Function_Return (sUserPassword = sEnteredPassword)
36978>>>>>        End
36978>>>>>>
36978>>>>>        
36978>>>>>        String sVersion
36978>>>>>        Move (Left(sUserPassword, 3)) to sVersion
36979>>>>>        If (sVersion = "V1$") Begin
36981>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
36984>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
36985>>>>>        End
36985>>>>>>
36985>>>>>        Else Begin
36986>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
36989>>>>>            Function_Return False
36990>>>>>        End
36990>>>>>>
36990>>>>>    End_Function
36991>>>>>    
36991>>>>>    Function UserRegister String sLoginName String sPassword Returns Boolean
36993>>>>>        Handle hoUserDD
36993>>>>>        Integer iErr
36993>>>>>        Get phoUserDD to hoUserDD
36994>>>>>        
36994>>>>>        //  Find the user
36994>>>>>        Send Clear of hoUserDD
36995>>>>>        Move sLoginName to WebAppUser.LoginName
36996>>>>>        Send Find of hoUserDD EQ Index.1
36997>>>>>        If (Found) Begin
36999>>>>>            Send Clear of hoUserDD
37000>>>>>            Function_Return False
37001>>>>>        End
37001>>>>>>
37001>>>>>        
37001>>>>>        Send Clear of hoUserDD
37002>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.FullName to sLoginName
37003>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.LoginName to sLoginName
37004>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37006>>>>>            Send Clear of hoUserDD
37007>>>>>            Function_Return False
37008>>>>>        End
37008>>>>>>
37008>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37009>>>>>        Get Request_Validate of hoUserDD to iErr
37010>>>>>        If (iErr) Begin
37012>>>>>            Send Clear of hoUserDD
37013>>>>>            Function_Return False
37014>>>>>        End
37014>>>>>>
37014>>>>>        
37014>>>>>        Send Request_Save of hoUserDD
37015>>>>>        Function_Return (not(Err))
37016>>>>>    End_Function
37017>>>>>    
37017>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
37019>>>>>        String sSessionKey sUserPassword
37019>>>>>        Handle hoSessionDD hoUserDD
37019>>>>>        Boolean bMatch bUpgrade
37019>>>>>        
37019>>>>>        Get phoSessionDD to hoSessionDD
37020>>>>>        Get phoUserDD to hoUserDD
37021>>>>>        Integer iErr eLoginMode
37021>>>>>        
37021>>>>>        // Refind session record
37021>>>>>        Get psSessionKey to sSessionKey
37022>>>>>        Send Clear of hoSessionDD
37023>>>>>        Move sSessionKey to WebAppSession.SessionKey
37024>>>>>        Send Find of hoSessionDD EQ Index.1
37025>>>>>        
37025>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
37027>>>>>            Get peLoginMode to eLoginMode
37028>>>>>            
37028>>>>>            //  Find the user
37028>>>>>            Move sLoginName to WebAppUser.LoginName
37029>>>>>            Send Find of hoUserDD EQ Index.1
37030>>>>>            
37030>>>>>            // Check username and password
37030>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
37032>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
37033>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
37034>>>>>                
37034>>>>>                If (bMatch) Begin
37036>>>>>                    // Store the login
37036>>>>>                    If (bUpgrade) Begin
37038>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
37039>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37042>>>>>                    End
37042>>>>>>
37042>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
37043>>>>>                    Get Request_Validate of hoSessionDD to iErr
37044>>>>>                    If (iErr) Begin
37046>>>>>                        // this should not happen. If it does its a programming error
37046>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37047>>>>>>
37047>>>>>                        Function_Return False
37048>>>>>                    End
37048>>>>>>
37048>>>>>                    
37048>>>>>                    Send Request_Save of hoSessionDD
37049>>>>>                    
37049>>>>>                    // Update session properties
37049>>>>>                    Send UpdateSessionProperties False
37050>>>>>                    Send NotifyChangeRights
37051>>>>>                    Function_Return True
37052>>>>>                End
37052>>>>>>
37052>>>>>                Else Begin
37053>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
37053>>>>>                    Send Clear of hoUserDD
37054>>>>>                End
37054>>>>>>
37054>>>>>            End
37054>>>>>>
37054>>>>>            Else Begin
37055>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37055>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37056>>>>>            End
37056>>>>>>
37056>>>>>        End
37056>>>>>>
37056>>>>>        Else Begin
37057>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37057>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37058>>>>>        End
37058>>>>>>
37058>>>>>          
37058>>>>>        Function_Return False
37059>>>>>    End_Function
37060>>>>>    
37060>>>>>    Function SetUserPassword String sLoginName String sPassword Returns Boolean
37062>>>>>        Handle hoUserDD
37062>>>>>        Integer iErr
37062>>>>>        Get phoUserDD to hoUserDD
37063>>>>>        
37063>>>>>        //  Find the user
37063>>>>>        Send Clear of hoUserDD
37064>>>>>        Move sLoginName to WebAppUser.LoginName
37065>>>>>        Send Find of hoUserDD EQ Index.1
37066>>>>>        If (not(Found)) Begin
37068>>>>>            Send Clear of hoUserDD
37069>>>>>            Function_Return False
37070>>>>>        End
37070>>>>>>
37070>>>>>        
37070>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37072>>>>>            Send Clear of hoUserDD
37073>>>>>            Function_Return False
37074>>>>>        End
37074>>>>>>
37074>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37075>>>>>        Get Request_Validate of hoUserDD to iErr
37076>>>>>        If (iErr) Begin
37078>>>>>            Send Clear of hoUserDD
37079>>>>>            Function_Return False
37080>>>>>        End
37080>>>>>>
37080>>>>>        
37080>>>>>        Send Request_Save of hoUserDD
37081>>>>>        Function_Return (not(Err))
37082>>>>>    End_Function
37083>>>>>    
37083>>>>>    Function IsLoggedIn Returns Boolean
37085>>>>>        String sLoginName
37085>>>>>        Boolean bLogWebSession bLoggedIn
37085>>>>>        
37085>>>>>        Get pbLogWebSession to bLogWebSession
37086>>>>>        If not bLogWebSession Begin
37088>>>>>            Forward Get IsLoggedIn to bLoggedIn
37090>>>>>            Function_Return bLoggedIn
37091>>>>>        End
37091>>>>>>
37091>>>>>        
37091>>>>>        Get psLoginName to sLoginName
37092>>>>>        
37092>>>>>        Function_Return (sLoginName <> "")
37093>>>>>    End_Function
37094>>>>>    
37094>>>>>    
37094>>>>>    //
37094>>>>>    // This procedure is called when validating a session and after logging in. Its purpose is to 
37094>>>>>    // update properties based on the session and user data. Augment this function to update 
37094>>>>>    // properties based on the session / user table. Note that WebAppUser and WebAppSession contain
37094>>>>>    // the right records when this procedure is called.
37094>>>>>    //
37094>>>>>    // Params:
37094>>>>>    //      bClear   True if the procedure is called before session validation to clear properties.
37094>>>>>    //
37094>>>>>    Procedure UpdateSessionProperties Boolean bClear
37096>>>>>        Handle hoUserDD
37096>>>>>        
37096>>>>>        Get phoUserDD to hoUserDD
37097>>>>>        
37097>>>>>        //  Update user properties
37097>>>>>        If (not(bClear) and HasRecord(hoUserDD)) Begin
37099>>>>>            Set psUsername to (Trim(WebAppUser.FullName))
37100>>>>>            Set psLoginName to (Trim(WebAppUser.LoginName))
37101>>>>>            Set piUserRights to WebAppUser.Rights
37102>>>>>            
37102>>>>>            Send OnSessionPropertiesSet 
37103>>>>>        End
37103>>>>>>
37103>>>>>        Else Begin
37104>>>>>            Set psUsername to ""
37105>>>>>            Set psLoginName to ""
37106>>>>>            Set piUserRights to 0
37107>>>>>            
37107>>>>>            Send OnSessionPropertiesClear
37108>>>>>        End
37108>>>>>>
37108>>>>>    End_Procedure
37109>>>>>    
37109>>>>>    Procedure OnSessionPropertiesSet
37111>>>>>        //  Empty event stub
37111>>>>>    End_Procedure
37112>>>>>    
37112>>>>>    Procedure OnSessionPropertiesClear
37114>>>>>        //  Empty event stub
37114>>>>>    End_Procedure
37115>>>>>    
37115>>>>>    Procedure EndSession
37117>>>>>        Integer iErr
37117>>>>>        Boolean bLogWebSession
37117>>>>>        Handle hoSessionDD       
37117>>>>>        
37117>>>>>        Get phoSessionDD to hoSessionDD
37118>>>>>        Get pbLogWebSession to bLogWebSession
37119>>>>>        If not bLogWebSession Begin
37121>>>>>            Forward Send EndSession
37123>>>>>            Procedure_Return
37124>>>>>        End
37124>>>>>>
37124>>>>>            
37124>>>>>        //  Check if session exists
37124>>>>>        Send Clear of hoSessionDD
37125>>>>>        Get psSessionKey to WebAppSession.SessionKey
37126>>>>>        
37126>>>>>        Send Find of hoSessionDD EQ Index.1
37127>>>>>        If (Found) Begin
37129>>>>>            Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "N"
37130>>>>>            Get Request_Validate of hoSessionDD to iErr
37131>>>>>            If (iErr) Begin
37133>>>>>                // this should not happen. If it does its a programming error
37133>>>>>                Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37134>>>>>>
37134>>>>>                Procedure_Return
37135>>>>>            End
37135>>>>>>
37135>>>>>            Send Request_Save of hoSessionDD
37136>>>>>        End
37136>>>>>>
37136>>>>>    End_Procedure
37137>>>>>
37137>>>>>End_Class
