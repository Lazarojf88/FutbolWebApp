37225>>>    Procedure DoLogin
37228>>>        String sLoginName sPassword sPrevStateHash
37228>>>        Boolean bResult
37228>>>        
37228>>>        WebGet psValue of oLoginName to sLoginName
37229>>>        WebGet psValue of oPassword to sPassword
37230>>>        
37230>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37231>>>        
37231>>>        If (bResult) Begin
37233>>>            Send Hide of oLogin
37234>>>            Send ShowHeader of ghoWebApp
37235>>>            WebSet psCSSClass of ghoWebApp to ""
37236>>>            
37236>>>            WebGet psPrevStateHash to sPrevStateHash
37237>>>            Send NavigateToStateHash of ghoWebApp sPrevStateHash True
37238>>>            
37238>>>            // clear the login values. we don't want to return the login id & password as synchronized properties....
37238>>>            WebSet psValue of oLoginName to ""
37239>>>            WebSet psValue of oPassword  to ""
37240>>>            WebSet pbVisible of oWarning to False
37241>>>        End
37241>>>>
37241>>>        Else Begin
37242>>>            WebSet pbVisible of oWarning to True
37243>>>        End
37243>>>>
37243>>>    End_Procedure
37244>>>    
37244>>>    Procedure OnSubmit
37247>>>        Send DoLogin
37248>>>    End_Procedure
37249>>>    
37249>>>    Procedure OnLoad
37252>>>        String sPrevStateHash sView
37252>>>        
37252>>>        Forward Send OnLoad
37254>>>        
37254>>>        //  Store the current state so we can go back to that later (only if it points to a different view)
37254>>>        Get StateHash of ghoWebApp to sPrevStateHash
37255>>>        Send ParseViewStateHash sPrevStateHash (&sView)
37256>>>        If (Lowercase(sView) <> Lowercase(psStateViewName(Self))) Begin
37258>>>            WebSet psPrevStateHash to sPrevStateHash
37259>>>        End
37259>>>>
37259>>>        
37259>>>    End_Procedure
