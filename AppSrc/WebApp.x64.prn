36653>>>>>>>        Move (ResizeArray(ucaBuffer, iLen)) to ucaBuffer
36654>>>>>>>        Move (MemCopy(AddressOf(ucaBuffer), pBase64, iLen)) to iLen
36655>>>>>>>        Move (Free(pBase64)) to iLen
36656>>>>>>>        Function_Return ucaBuffer
36657>>>>>>>    End_Function
36658>>>>>>>    
36658>>>>>>>    Function CreatePasswordHashExWithSalt UInteger uiAlgo UChar[] ucaSalt String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36660>>>>>>>        Boolean bOk bRequireTimeCost
36660>>>>>>>        UChar[] ucaHash
36661>>>>>>>        
36661>>>>>>>        Case Begin
36661>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36663>>>>>>>                Get CNG_PBKDF2_HMAC "SHA256" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36664>>>>>>>                If (not(bOk)) Function_Return False
36667>>>>>>>                
36667>>>>>>>                Move True to bRequireTimeCost
36668>>>>>>>                Case Break
36669>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36672>>>>>>>                Get CNG_PBKDF2_HMAC "SHA512" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36673>>>>>>>                If (not(bOk)) Function_Return False
36676>>>>>>>                
36676>>>>>>>                Move True to bRequireTimeCost
36677>>>>>>>                Case Break
36678>>>>>>>            Case Else
36678>>>>>>>                Error 8710 "Invalid algorithm selected."
36679>>>>>>>>
36679>>>>>>>                Function_Return False
36680>>>>>>>        Case End
36680>>>>>>>        
36680>>>>>>>        String sSalt
36680>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36681>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return False
36684>>>>>>>        Get Base64EncodeArr ucaHash to sHash
36685>>>>>>>        If (not(SizeOfString(sHash))) Function_Return False
36688>>>>>>>        
36688>>>>>>>        If (bRequireTimeCost) Begin
36690>>>>>>>            Move (SFormat("%1$%2$%3$%4",            ;                            String(uiAlgo),         ;                            sSalt,                  ;                            String(uiOptTimeCost),  ;                            sHash)) to sHash
36691>>>>>>>        End
36691>>>>>>>>
36691>>>>>>>        Else Begin
36692>>>>>>>            Move (SFormat("%1$%2$%3",               ;                            String(uiAlgo),         ;                            sSalt,                  ;                            sHash)) to sHash
36693>>>>>>>        End
36693>>>>>>>>
36693>>>>>>>        
36693>>>>>>>        Function_Return bOk
36694>>>>>>>    End_Function
36695>>>>>>>    
36695>>>>>>>    Function CreatePasswordHashEx UInteger uiAlgo UInteger uiSaltSize String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36697>>>>>>>        UChar[] ucaSalt
36698>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36699>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36702>>>>>>>        
36702>>>>>>>        If (num_arguments > 4) Begin
36704>>>>>>>            Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash, uiOptTimeCost))
36705>>>>>>>        End
36705>>>>>>>>
36705>>>>>>>        Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash))
36706>>>>>>>    End_Function
36707>>>>>>>    
36707>>>>>>>    Function VerifyPasswordHash String sPassword String sHash Returns Boolean
36709>>>>>>>        Boolean bRequiresTimeCost
36709>>>>>>>        UInteger uiAlgo uiTimeCost
36709>>>>>>>        Integer iBegin iEnd
36709>>>>>>>        String sSalt
36709>>>>>>>        
36709>>>>>>>        Move 1 to iBegin
36710>>>>>>>        
36710>>>>>>>        // Parse Algo
36710>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36711>>>>>>>        If (not(iEnd)) Function_Return False
36714>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiAlgo
36715>>>>>>>        
36715>>>>>>>        // Parse Salt
36715>>>>>>>        Move (iEnd + 1) to iBegin
36716>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36717>>>>>>>        If (not(iEnd)) Function_Return False
36720>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to sSalt
36721>>>>>>>        
36721>>>>>>>        Case Begin
36721>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36723>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36726>>>>>>>                Move True to bRequiresTimeCost
36727>>>>>>>                Case Break
36728>>>>>>>            Case Else
36728>>>>>>>                Error 8710 "Invalid algorithm selected."
36729>>>>>>>>
36729>>>>>>>                Function_Return False
36730>>>>>>>        Case End
36730>>>>>>>        
36730>>>>>>>        // Parse optional timecost
36730>>>>>>>        If (bRequiresTimeCost) Begin
36732>>>>>>>            Move (iEnd + 1) to iBegin
36733>>>>>>>            Move (Pos("$", sHash, iBegin)) to iEnd
36734>>>>>>>            If (not(iEnd)) Function_Return False
36737>>>>>>>            Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiTimeCost
36738>>>>>>>        End
36738>>>>>>>>
36738>>>>>>>        
36738>>>>>>>        // Parse rest hash
36738>>>>>>>        Move (iEnd + 1) to iBegin
36739>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36740>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
36743>>>>>>>        
36743>>>>>>>        // Base64Decode
36743>>>>>>>        UChar[] ucaSalt
36744>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
36745>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36748>>>>>>>        
36748>>>>>>>        // Create new hash
36748>>>>>>>        String sNewHash
36748>>>>>>>        If (bRequiresTimeCost) Begin
36750>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
36752>>>>>>>                Function_Return False 
36753>>>>>>>            End
36753>>>>>>>>
36753>>>>>>>        End
36753>>>>>>>>
36753>>>>>>>        Else Begin
36754>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
36756>>>>>>>                Function_Return False 
36757>>>>>>>            End
36757>>>>>>>>
36757>>>>>>>        End
36757>>>>>>>>
36757>>>>>>>        Function_Return (sNewHash = sHash)
36758>>>>>>>    End_Function
36759>>>>>>>    
36759>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
36761>>>>>>>        Boolean bRequireTimeCost
36761>>>>>>>        UBigInt ullSize
36761>>>>>>>        UChar[] ucaSalt
36762>>>>>>>        String sSalt
36762>>>>>>>        
36762>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36763>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36764>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
36767>>>>>>>        
36767>>>>>>>        Case Begin
36767>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36769>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
36770>>>>>>>                Move True to bRequireTimeCost
36771>>>>>>>                Case Break
36772>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36775>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
36776>>>>>>>                Move True to bRequireTimeCost
36777>>>>>>>                Case Break
36778>>>>>>>            Case Else
36778>>>>>>>                Error 8710 "Invalid algorithm selected."
36779>>>>>>>>
36779>>>>>>>                Function_Return 0
36780>>>>>>>        Case End
36780>>>>>>>        
36780>>>>>>>        // calculate base64 in a non-floating-manner
36780>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
36781>>>>>>>        
36781>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
36782>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
36783>>>>>>>        If (bRequireTimeCost) Begin
36785>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
36786>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
36787>>>>>>>        End
36787>>>>>>>>
36787>>>>>>>        Else Begin
36788>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
36789>>>>>>>        End
36789>>>>>>>>
36789>>>>>>>        
36789>>>>>>>        Function_Return ullSize
36790>>>>>>>    End_Function
36791>>>>>>>End_Class
36792>>>>>>>
36792>>>>>>>Class cPasswordHasher is a cObject
36793>>>>>>>    
36793>>>>>>>    Import_Class_Protocol cPasswordHasher_Mixin
36794>>>>>>>    
36794>>>>>>>    Procedure Construct_Object
36796>>>>>>>        Forward Send Construct_Object
36798>>>>>>>        
36798>>>>>>>        Property UInteger   peAlgorithm         C_PWH_PBKDF2_HMAC_SHA_512 
36799>>>>>>>        Property UInteger   puiSaltSize         16
36800>>>>>>>        
36800>>>>>>>        Property UInteger   puiOptTimeCost      420000
36801>>>>>>>    End_Procedure
36802>>>>>>>    
36802>>>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36804>>>>>>>        Boolean bOk
36804>>>>>>>        UInteger uiAlgo
36804>>>>>>>        Get peAlgorithm to uiAlgo
36805>>>>>>>        
36805>>>>>>>        Case Begin
36805>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36807>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36810>>>>>>>                Get CreatePasswordHashEx uiAlgo (puiSaltSize(Self)) sPassword (&sHash) (puiOptTimeCost(Self)) to bOk
36811>>>>>>>                Case Break
36812>>>>>>>            Case Else
36812>>>>>>>                Error 8710 "Invalid algorithm selected."
36813>>>>>>>>
36813>>>>>>>                Function_Return False
36814>>>>>>>        Case End
36814>>>>>>>        
36814>>>>>>>        Function_Return bOk
36815>>>>>>>    End_Function
36816>>>>>>>    
36816>>>>>>>    Function RequiredBufferSize Returns UBigInt
36818>>>>>>>        UBigInt ullSize
36818>>>>>>>        UInteger uiAlgo
36818>>>>>>>        Get peAlgorithm to uiAlgo
36819>>>>>>>        
36819>>>>>>>        Case Begin
36819>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36821>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36824>>>>>>>                Get RequiredBufferSizeEx uiAlgo (puiSaltSize(Self)) (puiOptTimeCost(Self)) to ullSize
36825>>>>>>>                Case Break
36826>>>>>>>            Case Else
36826>>>>>>>                Error 8710 "Invalid algorithm selected."
36827>>>>>>>>
36827>>>>>>>                Function_Return 0
36828>>>>>>>        Case End
36828>>>>>>>        
36828>>>>>>>        Function_Return ullSize
36829>>>>>>>    End_Function
36830>>>>>>>
36830>>>>>>>End_Class
