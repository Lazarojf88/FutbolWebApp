Use cWebView.pkg
Use cWebPanel.pkg
Use cWebHtmlBox.pkg

Object oDashboard is a cWebView

    Set piMaxWidth to 1024
    Set psCaption to "Dashboard"
    Set peViewType to vtUndefined
    Set pbShowCaption to False
    Set psCSSClass to "Dashboard"
    
    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 24
        
        WebSetResponsive piColumnCount rmMobile to 1
        WebSetResponsive piColumnCount rmTabletPortrait to 16
    
        Object oTiles_grp is a cWebGroup
            Set piColumnSpan to 8
            Set pbShowBorder to False
            Set pbShowCaption to False
            Set piColumnCount to 12
            Set psCSSClass to "TilesGroup"

            // 🔹 JUGADORES
            Object oTileJugadores is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set psCSSClass to "Tile Light"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="OnClick"><div class="Tile_Title">Jugadores</div></div>'

                Procedure OnClick String sId String sParam
                    Send NavigateForward to oJugadorSelect Self
                End_Procedure
            End_Object

            // 🔹 ENTRENADORES
            Object oTileEntrenadores is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set piColumnIndex to 6
                Set psCSSClass to "Tile LightAlternate"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="OnClick"><div class="Tile_Title">Entrenadores</div></div>'

                Procedure OnClick String sId String sParam
                    Send NavigateForward to oEntrenadorSelect Self
                End_Procedure
            End_Object

            // 🔹 EQUIPOS
            Object oTileEquipos is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set psCSSClass to "Tile Dark"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="OnClick"><div class="Tile_Title">Equipos</div></div>'

                Procedure OnClick String sId String sParam
                    Send NavigateForward to oEquipoSelect Self
                End_Procedure
            End_Object

            // 🔹 POSICIONES
            Object oTilePosiciones is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set piColumnIndex to 6
                Set psCSSClass to "Tile DarkAlternate"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="OnClick"><div class="Tile_Title">Posiciones</div></div>'

                Procedure OnClick String sId String sParam
                    Send NavigateForward to oPosicionSelect Self
                End_Procedure
            End_Object

            // 🔹 LIGAS
            Object oTileLigas is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set psCSSClass to "Tile Light"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="OnClick"><div class="Tile_Title">Ligas</div></div>'

                Procedure OnClick String sId String sParam
                    Send NavigateForward to oLigaSelect Self
                End_Procedure
            End_Object

        End_Object
    
    End_Object

End_Object